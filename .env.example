# ─────────────────────────────────────────────────────────────────────────────
# JKT48 Archive Lab — environment template  (PRD §28)
# Copy to `.env` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Serverless functions must not assume a long-lived connection (PRD §31).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by `prisma migrate` / `prisma db seed`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase project — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."

# Server-only. NEVER prefix with NEXT_PUBLIC_ (PRD §35).
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Public site origin, used for auth redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: bootstrap the first ADMIN account by email on seed.
SEED_ADMIN_EMAIL=""
